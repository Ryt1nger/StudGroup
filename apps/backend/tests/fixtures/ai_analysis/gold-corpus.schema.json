{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studgroup.local/schemas/ai-gold-corpus-entry.json",
  "title": "StudGroup AI gold corpus entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "split", "discussion_id", "sources", "expected_items"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "evaluation"]},
    "discussion_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "revision", "message_time", "text"],
        "properties": {
          "source_id": {"type": "integer"},
          "revision": {"type": "integer", "minimum": 1},
          "message_time": {"type": "string", "format": "date-time"},
          "author_alias": {"type": ["string", "null"]},
          "reply_to_source_id": {"type": ["integer", "null"]},
          "text": {"type": ["string", "null"]},
          "attachment_kinds": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "expected_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "destination", "action", "subject", "content", "evidence"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "destination": {"enum": ["task", "deadline"]},
          "action": {"enum": ["create", "enrich", "correct", "reschedule", "cancel", "reopen", "no_change"]},
          "subject": {"type": ["string", "null"]},
          "semantic_label": {"type": ["string", "null"]},
          "content": {"type": "string", "minLength": 1},
          "deadline": {"type": ["string", "null"], "format": "date-time"},
          "date_basis": {"enum": ["explicit", "relative_resolved", "schedule_inferred", "unknown", "conflict"]},
          "audience_label": {"type": ["string", "null"]},
          "publication": {"enum": ["normal", "needs_attention", "review"]},
          "display_title": {"type": ["string", "null"]},
          "display_description": {"type": ["string", "null"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "source_id", "revision"],
              "properties": {
                "field": {"type": "string", "minLength": 1},
                "source_id": {"type": "integer"},
                "revision": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "negative_reason": {"type": ["string", "null"]}
  }
}
