# Application
APP_ENV=local
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://studgroup:studgroup@postgres:5432/studgroup

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_LIVE_TWO_PASS=true
AI_DAILY_GROUP_BUDGET_USD=0.05
AI_HOURLY_GROUP_BUDGET_USD=0.25
AI_TOTAL_BUDGET_USD=1.70
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=300
AI_MAX_RECOVERABLE_ATTEMPTS_PER_STAGE=8

# S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoring
ERROR_TRACKING_DSN=
