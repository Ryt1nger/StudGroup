# Application
APP_ENV=local
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://studgroup:studgroup@postgres:5432/studgroup

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_PAGE_URL=http://localhost:8000/admin/

# Public support contact shown by /support (optional)
SUPPORT_CONTACT=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_LIVE_TWO_PASS=true
# Development/shadow diagnostics only. Raw provider responses expire after 30 days.
AI_STORE_RAW_PROVIDER_RESPONSES=false
# Development/shadow only. Enables one separately accounted JSON-format repair call.
AI_TECHNICAL_REPAIR_ENABLED=false
# New analysis is routed per group in the database. Missing settings always mean legacy.
# Shadow has a separate per-group budget and cannot publish cards or notifications.
AI_DAILY_GROUP_BUDGET_USD=0.05
AI_HOURLY_GROUP_BUDGET_USD=0.25
AI_TOTAL_BUDGET_USD=1.70
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=300
AI_MAX_RECOVERABLE_ATTEMPTS_PER_STAGE=8

# S3-compatible storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoring
ERROR_TRACKING_DSN=

# Group billing (disabled until an approved Stars price is configured)
# One-time purchases: 1-4 blocks of 30 days, base public tariff 800 RUB/month/group.
# Telegram requires XTR inside the bot; this is a separately selected Stars price.
BILLING_ENABLED=false
BILLING_STARS_PER_MONTH=0
# Additional gate: do not restrict ingestion on first rollout.
BILLING_ENFORCE_ACCESS=false
