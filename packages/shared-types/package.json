{
  "name": "@studgroup/shared-types",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "TypeScript client and types generated from packages/contracts/openapi.yaml. Never edit src/generated by hand.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples.generated.ts"
  },
  "scripts": {
    "generate": "openapi-ts && node scripts/generate-examples.mjs",
    "check:drift": "pnpm generate && git diff --exit-code -- src"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {}
}