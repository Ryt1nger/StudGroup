# Copy to .env.pilot, fill locally; never paste actual secrets into chat.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql+asyncpg://studgroup:replace_with_url_encoded_password@postgres:5432/studgroup
REDIS_URL=redis://redis:6379/0
WEBAPP_ORIGIN=https://replace-with-frontend.pages.dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_USER_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_ENABLED=false
AI_ENABLED_UNTIL=
# Hard lock on the old per-message engine: it never writes cards unless this is true.
LEGACY_ENGINE_ENABLED=false
# New (package) engine: live writer for groups in analysis mode `new`. Off until the owner approves.
NEW_ENGINE_ENABLED=false
NEW_ENGINE_ENABLED_UNTIL=
# Student notifications for cards the new engine creates (keep false while backfilling history).
NEW_ENGINE_NOTIFICATIONS=false
AI_IMPORT_CHAT_ID=
AI_DAILY_GROUP_BUDGET_USD=0.05
AI_HOURLY_GROUP_BUDGET_USD=0.25
AI_TOTAL_BUDGET_USD=1.70
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=300
AI_MAX_RECOVERABLE_ATTEMPTS_PER_STAGE=8
